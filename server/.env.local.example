# ══════════════════════════════════════════════════════════════
# Local development on Windows / 8 GB GPU — copy to .env
# Keeps the cloud / pod option intact (see .env.cloud and start_cloud.sh).
# ══════════════════════════════════════════════════════════════

SERVER_HOST=0.0.0.0
SERVER_PORT=8765
CONTROL_HOST=0.0.0.0
CONTROL_PORT=8766

# Keep recognition responsive while Chatterbox occupies the GPU.
STT_MODEL=small.en
STT_LANGUAGE=en
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8

# Granite 4 H 1B is the expressive low-latency character brain. Use
# granite4:350m-h for the absolute fastest but less nuanced profile.
LLM_MODEL=LiquidAI/lfm2.5-1.2b-instruct:latest
LLM_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.1
LLM_TOP_P=1.0
LLM_TOP_K=50
LLM_REPEAT_PENALTY=1.05
LLM_MAX_TOKENS=128
LLM_MAX_CONTEXT_TURNS=4
LLM_CONTEXT_SIZE=4096
LLM_KEEP_ALIVE=30m

VAD_CONFIDENCE=0.7
VAD_START_SECS=0.2
VAD_STOP_SECS=0.28
VAD_MIN_VOLUME=0.6

# Current low-latency local voice. The character runtime preset also selects it.
TTS_BACKEND=pocket
TTS_VOICE=af_heart
KOKORO_LANG_CODE=a
KOKORO_SPEED=1.0
# KOKORO_DEVICE empty = auto (CUDA if available, else CPU). Force "cpu" if VRAM tight.
KOKORO_DEVICE=

# Recommended low-latency profile: genuine CPU audio streaming in an isolated
# Python worker. The character preset selects it at runtime.
POCKET_TTS_URL=http://127.0.0.1:8770
POCKET_TTS_PYTHON=./.venv-pocket/Scripts/python.exe
POCKET_TTS_VOICE=azelma
POCKET_TTS_LANGUAGE=english
POCKET_TTS_AUTOSTART=true

# Expressive English alternative (350M, MIT). Install chatterbox-tts first,
# then switch TTS_BACKEND=chatterbox. A clean 6-10 second WAV is recommended.
CHATTERBOX_DEVICE=cuda
CHATTERBOX_REFERENCE_AUDIO=
CHATTERBOX_TEMPERATURE=0.8
CHATTERBOX_WARMUP=true

# Fully local quantized Orpheus streaming alternative. Install orpheus-cpp and
# a llama-cpp-python wheel, then set TTS_BACKEND=orpheus-cpp. Lower prebuffer
# starts audio sooner; 0.5 seconds is a practical smoothness/latency balance.
ORPHEUS_CPP_PREBUFFER_SECONDS=0.5
ORPHEUS_CPP_GPU_LAYERS=-1
ORPHEUS_CPP_VERBOSE=false

# HF cache: leave HF_HOME UNSET in this file. start_local.ps1 forces it to
# %USERPROFILE%\.cache\huggingface (C:\ NTFS) to avoid Windows symlink errors
# on non-NTFS drives. Set HF_HOME below only if you know your drive supports symlinks.
# HF_HOME=

# Cloud-only fields are harmless to leave unset locally:
HF_TOKEN=
TTS_MODEL=canopylabs/orpheus-3b-0.1-ft
VLLM_BASE_URL=http://localhost:8000/v1

# RAG / Knowledge Base
RAG_DB_PATH=./knowledge/db
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_DEVICE=cpu
RAG_TOP_K=3
RAG_COLLECTION_NAME=training_docs

# Character
CHARACTER_NAME=Alex
CHARACTER_DESCRIPTION=a friendly and patient training instructor
CHARACTER_PROFILE_PATH=./characters/alex.json
CHARACTERS_DIR=./characters
ACTIVE_CHARACTER_ID=alex

# Emotion Analysis (optional)
EMOTION_ENABLED=false
EMOTION_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
