# ── Server ──
SERVER_HOST=0.0.0.0
SERVER_PORT=8765

# ── Speech-to-Text (Faster Whisper) ──
STT_BACKEND=whisper
STT_MODEL=small
STT_LANGUAGE=en
STT_DEVICE=cuda
STT_COMPUTE_TYPE=float16
MOONSHINE_URL=http://127.0.0.1:8771
MOONSHINE_PYTHON=./.venv-moonshine/Scripts/python.exe
MOONSHINE_ARCH=small-streaming
MOONSHINE_AUTOSTART=true
MOONSHINE_PRE_ROLL_SECONDS=0.45

# ── LLM (Ollama) ──
LLM_MODEL=llama3.1:8b
LLM_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=160
LLM_CONTEXT_SIZE=2048

# End-of-speech hold. 0.18 s avoids clipping short corrections while preserving
# a sub-second warm response target on the tested RTX laptop.
VAD_STOP_SECS=0.18

# ── Text-to-Speech (Orpheus) ──
# Model: "medium-3b" (best quality, ~6GB VRAM) or a HuggingFace model path
TTS_MODEL=medium-3b
TTS_VOICE=tara
TTS_SAMPLE_RATE=24000

# Recommended local streaming voice (isolated Python 3.12 CPU worker)
POCKET_TTS_URL=http://127.0.0.1:8770
POCKET_TTS_PYTHON=./.venv-pocket/Scripts/python.exe
POCKET_TTS_VOICE=azelma
POCKET_TTS_LANGUAGE=english
POCKET_TTS_AUTOSTART=true

# ── RAG / Knowledge Base ──
RAG_DB_PATH=./knowledge/db
RAG_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
RAG_TOP_K=3
RAG_COLLECTION_NAME=training_docs

# ── Character ──
CHARACTER_NAME=Alex
CHARACTER_DESCRIPTION=a friendly and patient training instructor

# ── Emotion Analysis (optional) ──
EMOTION_ENABLED=false
EMOTION_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
