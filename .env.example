# ── Server ──
SERVER_HOST=0.0.0.0
SERVER_PORT=8765
CONTROL_HOST=0.0.0.0
CONTROL_PORT=8766

# ── Speech-to-Text (Faster Whisper) ──
STT_BACKEND=moonshine
STT_MODEL=small.en
STT_LANGUAGE=en
STT_DEVICE=cuda
STT_COMPUTE_TYPE=int8_float16
MOONSHINE_URL=http://127.0.0.1:8771
MOONSHINE_PYTHON=./.venv-moonshine/Scripts/python.exe
MOONSHINE_ARCH=small-streaming
MOONSHINE_AUTOSTART=true
MOONSHINE_PRE_ROLL_SECONDS=0.45
VAD_CONFIDENCE=0.7
VAD_START_SECS=0.2
VAD_STOP_SECS=0.28
VAD_MIN_VOLUME=0.6

# ── LLM (Ollama) ──
LLM_MODEL=llama3.2:3b
LLM_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.1
LLM_TOP_P=1.0
LLM_TOP_K=50
LLM_REPEAT_PENALTY=1.05
LLM_MAX_TOKENS=128
LLM_MAX_CONTEXT_TURNS=4
LLM_CONTEXT_SIZE=4096
LLM_KEEP_ALIVE=30m

# ── Text-to-Speech ──
TTS_BACKEND=kokoro
TTS_VOICE=af_heart
TTS_SAMPLE_RATE=24000
KOKORO_LANG_CODE=a
KOKORO_SPEED=1.0
KOKORO_DEVICE=
POCKET_TTS_URL=http://127.0.0.1:8770
POCKET_TTS_PYTHON=./.venv-pocket/Scripts/python.exe
POCKET_TTS_VOICE=azelma
POCKET_TTS_LANGUAGE=english
POCKET_TTS_AUTOSTART=true
CHATTERBOX_DEVICE=cuda
CHATTERBOX_REFERENCE_AUDIO=
CHATTERBOX_TEMPERATURE=0.8
TTS_MODEL=canopylabs/orpheus-3b-0.1-ft
VLLM_BASE_URL=http://localhost:8000/v1
ORPHEUS_CPP_PREBUFFER_SECONDS=0.5
ORPHEUS_CPP_GPU_LAYERS=-1
ORPHEUS_CPP_VERBOSE=false

# ── RAG / Knowledge Base ──
RAG_DB_PATH=./knowledge/db
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_DEVICE=cpu
RAG_TOP_K=3
RAG_COLLECTION_NAME=training_docs

# ── Character ──
CHARACTER_NAME=Alex
CHARACTER_DESCRIPTION=a friendly and patient training instructor
CHARACTER_PROFILE_PATH=./characters/alex.json
CHARACTERS_DIR=./characters
ACTIVE_CHARACTER_ID=alex

# ── Emotion Analysis (optional) ──
EMOTION_ENABLED=false
EMOTION_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
